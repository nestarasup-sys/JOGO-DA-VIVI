{
  "name": "jogo-da-vivi-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:story && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:story": "node scripts/validate-story.mjs",
    "assets:inventory": "node scripts/inventory-assets.mjs",
    "assets:ai-import": "node scripts/import-ai-character-sheets.mjs",
    "assets:sheets": "npm run assets:inventory && npm run assets:ai-import && node scripts/build-asset-sheets.mjs",
    "assets:slice": "npm run assets:sheets && node scripts/slice-character-sheets.mjs",
    "assets:rebuild-all": "npm run assets:slice",
    "check": "npm run assets:inventory && npm run assets:slice && npm run validate:story && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
